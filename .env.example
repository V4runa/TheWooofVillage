# ----------------------------------------------------------------------------
# TheWooofVillage — Environment Variables
# Copy this file to `.env.local` for local dev, and set the same keys in the
# Vercel project dashboard (Settings → Environment Variables) for deployment.
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# Supabase
# The Vercel Marketplace Supabase integration auto-injects these (preferred):
#   NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY,
#   SUPABASE_URL, SUPABASE_SECRET_KEY
# Locally you can pull them with `vercel env pull .env.local`.
# Legacy names (NEXT_PUBLIC_SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY) are
# still accepted as fallbacks.
# ----------------------------------------------------------------------------

# Public (exposed to the browser; safe to ship)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server only (NEVER expose to the client). SUPABASE_URL may equal the public URL.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx

# Canonical production site URL (used for SEO metadata, Open Graph, sitemap,
# and robots). On Vercel this can be left unset to auto-use the deployment URL,
# but set it to your custom domain for correct canonical/OG links.
NEXT_PUBLIC_SITE_URL=https://www.thewooofvillage.com

# Admin login passcode (used to sign the admin session cookie).
ADMIN_PASSCODE=choose-a-strong-passcode

# Optional: dedicated secret for signing the admin session cookie.
# If unset, ADMIN_PASSCODE is used as the signing secret.
ADMIN_SESSION_SECRET=optional-long-random-string
